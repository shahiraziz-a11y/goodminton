# From Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# The app's one public address. Share links and link previews use it.
NEXT_PUBLIC_SITE_URL=https://goodminton-bice.vercel.app
# Currency for new matches
NEXT_PUBLIC_CURRENCY=AED
# Shown on /privacy and /terms (Google requires a contact). Optional.
NEXT_PUBLIC_CONTACT_EMAIL=

# Push alerts (see README: "Push alerts")
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
PUSH_WEBHOOK_SECRET=

# Email updates (README: "Email updates"). Server only.
GMAIL_USER=
GMAIL_APP_PASSWORD=
